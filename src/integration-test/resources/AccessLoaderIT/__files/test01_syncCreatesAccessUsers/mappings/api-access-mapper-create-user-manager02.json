{
	"request": {
		"method": "POST",
		"urlPath": "/api-access-mapper/2281/MY_NAMESPACE/access-config/user",
		"bodyPatterns": [
			{
				"equalToJson": {
					"userId": "manager02",
					"origin": "AUTOMATIC",
					"accessByType": [
						{
							"type": "label",
							"access": [
								{
									"pattern": "LOCATION/1/12/**",
									"accessLevel": "R"
								}
							]
						}
					]
				},
				"ignoreArrayOrder": true
			}
		]
	},
	"response": {
		"status": 201
	}
}
